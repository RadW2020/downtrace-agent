diff --git a/src/posts.js b/src/posts.js
new file mode 100644
index 0000000..f85b716
--- /dev/null
+++ b/src/posts.js
@@ -0,0 +1,18 @@
+const { getAuthor } = require("./authors");
+
+async function listPosts(pool) {
+  const { rows } = await pool.query("select id, title, author_id from posts order by id");
+  return rows;
+}
+
+async function getPost(pool, id) {
+  const { rows } = await pool.query("select id, title, author_id from posts where id = $1", [id]);
+  return rows[0];
+}
+
+// The shape the API returns for a post.
+async function serializePost(pool, post) {
+  return { id: post.id, title: post.title, author: await getAuthor(pool, post.author_id) };
+}
+
+module.exports = { listPosts, getPost, serializePost };
