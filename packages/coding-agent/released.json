      "list_captures",
      "list_errors",
      "list_findings",
      "list_projects",
      "list_regressions",
      "project_status",
      "read_capture",
      "read_captured_requests",
      "read_credential",
      "read_error",
      "read_finding",
      "read_history",
      "read_report",
      "record_regression",
      "request_capture",
      "resolve_error",
      "silence_alerts",
      "unignore_error",
      "verify_recovery"
