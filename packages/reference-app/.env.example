# Defaults match docker-compose.yml; copy to .env only to override.
PORT=4000
PROVIDER_PORT=4001
DATABASE_URL=postgres://downtrace:downtrace@localhost:5432/downtrace
REDIS_URL=redis://localhost:6379
APP_VERSION=dev
ADMIN_ENABLED=1
# Comma-separated regressions enabled at startup, e.g. n_plus_one,slow_dependency
REGRESSIONS=
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
# Answer 503 to product traffic for this many ms after the first request (simulated cold database); 0 disables
STARTUP_FAILURE_MS=0
# Host ports published by docker-compose.yml (change if something else uses them)
POSTGRES_PORT=5432
REDIS_PORT=6379
