{
  "name": "downtrace",
  "version": "0.1.2",
  "description": "npx downtrace check: names the routes a change made worse, an N+1 or a new call, before you push. The command of @downtrace/agent, with nothing to install first",
  "type": "module",
  "bin": {
    "downtrace": "./bin/downtrace.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --check bin/downtrace.js"
  },
  "dependencies": {
    "@downtrace/agent": "workspace:*"
  },
  "keywords": [
    "downtrace",
    "n+1",
    "performance",
    "regression",
    "testing",
    "ci",
    "coding-agent",
    "node"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RadW2020/downtrace-agent.git",
    "directory": "packages/downtrace"
  },
  "homepage": "https://github.com/RadW2020/downtrace-agent#readme",
  "bugs": {
    "url": "https://github.com/RadW2020/downtrace-agent/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
