{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RadW2020/downtrace-agent/main/packages/agent/schema/check.schema.json",
  "title": "downtrace check --json",
  "description": "What `downtrace check --json` prints: one object. Fields are only ever added under one schemaVersion, so a reader ignores what it does not know; a field removed, renamed or given another meaning moves schemaVersion, with a major version of @downtrace/agent.",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "status",
    "summary",
    "routes",
    "base",
    "change",
    "failure",
    "notes",
    "feedback"
  ],
  "properties": {
    "schema": { "const": "downtrace-check/1" },
    "schemaVersion": { "const": 1 },
    "status": {
      "description": "`failed` is «no comparison could be made», never «nothing got worse». The exit status says the same: 0 none worse, 1 at least one worse, 2 failed.",
      "enum": ["compared", "failed"]
    },
    "summary": {
      "description": "How many routes hold each verdict; null when no route was compared.",
      "anyOf": [{ "$ref": "#/$defs/summary" }, { "type": "null" }]
    },
    "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "base": { "anyOf": [{ "$ref": "#/$defs/side" }, { "type": "null" }] },
    "change": { "anyOf": [{ "$ref": "#/$defs/side" }, { "type": "null" }] },
    "failure": { "anyOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }] },
    "notes": { "type": "array", "items": { "type": "string" } },
    "feedback": {
      "description": "When Downtrace could not see something it is there to see: a link to a filled-in issue for a person to read and submit. Nothing is sent.",
      "anyOf": [{ "$ref": "#/$defs/feedback" }, { "type": "null" }]
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "required": ["worse", "unchanged", "notEvaluated"],
      "properties": {
        "worse": { "type": "integer", "minimum": 0 },
        "unchanged": { "type": "integer", "minimum": 0 },
        "notEvaluated": { "type": "integer", "minimum": 0 }
      }
    },
    "side": {
      "description": "One of the two runs, and what it left.",
      "type": "object",
      "required": [
        "ref",
        "commit",
        "command",
        "exitCode",
        "durationMs",
        "processes",
        "batches",
        "requests",
        "routes",
        "profileWindows",
        "malformed",
        "observers"
      ],
      "properties": {
        "ref": { "description": "The ref it ran at, or `working tree`.", "type": "string" },
        "commit": { "type": ["string", "null"] },
        "command": { "type": "string" },
        "exitCode": {
          "description": "The test command's exit status; null when it was killed.",
          "type": ["integer", "null"]
        },
        "durationMs": { "type": "number" },
        "processes": { "type": "integer", "minimum": 0 },
        "batches": { "type": "integer", "minimum": 0 },
        "requests": { "type": "integer", "minimum": 0 },
        "routes": { "type": "integer", "minimum": 0 },
        "profileWindows": { "type": "integer", "minimum": 0 },
        "malformed": { "description": "Lines that could not be read.", "type": "integer", "minimum": 0 },
        "observers": {
          "description": "What the instrumentation said it observed, by driver.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "failure": {
      "description": "Why no comparison was made.",
      "type": "object",
      "required": ["code", "side", "message", "advice", "outputTail"],
      "properties": {
        "code": {
          "enum": [
            "not-a-repository",
            "bad-ref",
            "bad-config",
            "no-command",
            "setup-failed",
            "command-failed",
            "timeout",
            "no-profile",
            "nothing-evaluated",
            "interrupted"
          ]
        },
        "side": { "enum": ["base", "change", null] },
        "message": { "type": "string" },
        "advice": { "type": ["string", "null"] },
        "outputTail": {
          "description": "The last of the test command's output, when it is what failed.",
          "type": ["string", "null"]
        }
      }
    },
    "feedback": {
      "type": "object",
      "required": ["why", "url"],
      "properties": {
        "why": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "method",
        "route",
        "verdict",
        "reasons",
        "requests",
        "profiledRequests",
        "operations",
        "dependencies",
        "meanRequestMs"
      ],
      "properties": {
        "id": { "description": "`POST /checkout`: the same in every run.", "type": "string" },
        "method": { "type": "string" },
        "route": { "type": "string" },
        "verdict": { "enum": ["worse", "unchanged", "not-evaluated"] },
        "reasons": {
          "description": "Why it was not evaluated; empty for the other two verdicts.",
          "type": "array",
          "items": { "$ref": "#/$defs/reason" }
        },
        "requests": { "$ref": "#/$defs/counts" },
        "profiledRequests": {
          "description": "The requests whose composition is known: what executions are divided by.",
          "$ref": "#/$defs/counts"
        },
        "operations": {
          "description": "Empty when the route was not evaluated.",
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "meanRequestMs": { "description": "Data, never judged.", "$ref": "#/$defs/durations" }
      }
    },
    "reason": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "bucket",
            "not-called",
            "not-called-in-base",
            "not-called-in-change",
            "no-profile-in-base",
            "no-profile-in-change",
            "nothing-observed"
          ]
        },
        "message": { "type": "string" }
      }
    },
    "operation": {
      "description": "One query, outgoing call or command of a route.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "hash",
        "label",
        "change",
        "worse",
        "judged",
        "perRequest",
        "executions",
        "msPerExecution"
      ],
      "properties": {
        "id": { "description": "The kind and the fingerprint: the same in every run.", "type": "string" },
        "kind": { "enum": ["query", "call", "command"] },
        "hash": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] },
        "change": { "enum": ["appeared", "multiplied", "unchanged", "reduced", "disappeared"] },
        "worse": { "type": "boolean" },
        "judged": {
          "description": "False for a setting of the session: how it moved is said, and it is never worse.",
          "type": "boolean"
        },
        "replacement": {
          "description": "Present, and true, on an operation that appeared in the place of one that is gone: it is not worse.",
          "const": true
        },
        "perRequest": { "$ref": "#/$defs/numbers" },
        "executions": { "$ref": "#/$defs/counts" },
        "msPerExecution": { "description": "Data, never judged.", "$ref": "#/$defs/durations" },
        "sites": {
          "description": "On an operation that got worse: up to three `file:line` of the project that ran it.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dependency": {
      "description": "Everything one kind did for a route: all its queries, all its calls, all its commands.",
      "type": "object",
      "required": ["kind", "perRequest", "worse"],
      "properties": {
        "kind": { "enum": ["query", "call", "command"] },
        "perRequest": { "$ref": "#/$defs/numbers" },
        "worse": { "type": "boolean" }
      }
    },
    "counts": {
      "type": "object",
      "required": ["base", "change"],
      "properties": {
        "base": { "type": "integer", "minimum": 0 },
        "change": { "type": "integer", "minimum": 0 }
      }
    },
    "numbers": {
      "type": "object",
      "required": ["base", "change"],
      "properties": {
        "base": { "type": "number", "minimum": 0 },
        "change": { "type": "number", "minimum": 0 }
      }
    },
    "durations": {
      "type": "object",
      "required": ["base", "change"],
      "properties": {
        "base": { "type": ["number", "null"] },
        "change": { "type": ["number", "null"] }
      }
    }
  }
}
