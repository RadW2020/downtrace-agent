{
  "name": "@downtrace/agent",
  "version": "0.14.0",
  "description": "Catch N+1 queries and new calls before you deploy: downtrace check compares your test runs route by route, with no account. In production, a flight recorder for your Node.js backend, never in your request path.",
  "type": "module",
  "bin": {
    "downtrace": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "node -e \"const p=require('./package.json');if(!JSON.stringify([p.exports,p.bin,p.main,p.types]).includes('./src/'))process.exit(0);console.error('\\n  '+p.name+' publishes through publishConfig, which npm does not apply and pnpm does.\\n  Publishing from here would ship entry points the tarball does not carry, which is how\\n  @downtrace/mcp@0.1.0 went out broken (gh-421). Pack it first, as CI does:\\n\\n    pnpm pack --pack-destination /tmp && npm publish /tmp/<tarball> --access public\\n');process.exit(1)\"",
    "test": "vitest run",
    "test:measure": "DOWNTRACE_MEASURE=1 vitest run measure",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "dependencies": {
    "@downtrace/protocol": "workspace:*"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.17",
    "@koa/router": "^15.7.0",
    "@koa/router12": "npm:@koa/router@^12.0.2",
    "@libsql/client": "^0.18.0",
    "@prisma/client": "^6.19.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express4": "npm:@types/express@^4.17.25",
    "@types/koa": "^3.0.3",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "express4": "npm:express@^4",
    "fastify": "^5.12.7",
    "fastify4": "npm:fastify@^4.29.1",
    "hono": "^4.13.14",
    "jest": "^30.5.2",
    "jest29": "npm:jest@^29.7.0",
    "koa": "^3.2.1",
    "libsql": "^0.5.29",
    "mongodb": "^7.7.0",
    "mongodb6": "npm:mongodb@^6.21.0",
    "mongoose": "^9.11.4",
    "mysql2": "^3.24.5",
    "mysql2-legacy": "npm:mysql2@3.11.5",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "prisma": "^6.19.3",
    "redis": "^6.3.0",
    "redis5": "npm:redis@^5.12.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RadW2020/downtrace-agent.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/RadW2020/downtrace-agent#readme",
  "keywords": [
    "downtrace",
    "n+1",
    "performance",
    "regression",
    "testing",
    "ci",
    "express",
    "postgres",
    "observability",
    "apm",
    "latency",
    "coding-agent",
    "mcp",
    "node"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "downtrace": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./register": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      }
    }
  }
}
